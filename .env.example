# Required. fal.ai dashboard -> Keys
FAL_KEY=
# Required. Vercel dashboard -> AI Gateway -> API Keys ($5 free credit on new accounts)
AI_GATEWAY_API_KEY=
# Required. Miris account settings -> API token
MIRIS_API_TOKEN=

# Everything below is optional. Leave blank unless a workshop helper tells you otherwise.

# Only needed if the Vercel CLI deploy path fails inside your sandbox (REST fallback).
# Vercel dashboard -> Settings -> Tokens
VERCEL_TOKEN=
# Only needed if you were given a non default Miris API environment to use.
MIRIS_API_BASE=
# Only needed if your Miris account requires a key to view processed assets.
# When set, it gets baked into your deployed viewer automatically.
VIEWER_KEY=
