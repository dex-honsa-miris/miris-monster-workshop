# The one key you need. fal.ai dashboard -> Keys -> create a key.
# A coupon code is announced at the workshop.
FAL_KEY=

# The public Miris workflow that turns your prompt into a concept image and
# lore. Leave blank to use the default; runs bill YOUR fal key.
FAL_WORKFLOW_ID=

# Publishing needs no key here: you upload your monster.glb in the Miris
# portal (https://app.miris.com) under your own account and paste the asset
# id into the app.

# Optional: bake a viewer key into the deployed viewer if your asset needs one.
VIEWER_KEY=
